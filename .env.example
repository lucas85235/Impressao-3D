# Copie para .env.local (uso local) ou cadastre na Vercel (Settings → Environment Variables).

# ── Banco de dados ────────────────────────────────────────────────
# Local (padrão): arquivo SQLite dentro do projeto
DATABASE_URL=file:./data/app.db
# Nuvem (Turso): DATABASE_URL=libsql://<seu-banco>-<seu-usuario>.turso.io
# DATABASE_AUTH_TOKEN=

# Fuso usado para "hoje" (vencimentos, atrasos)
APP_TIMEZONE=America/Sao_Paulo

# ── Segurança ─────────────────────────────────────────────────────
# Código pedido na criação da conta inicial em produção (escolha algo aleatório).
SETUP_CODE=

# ── Notificações push (gere com: npm run vapid) ───────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Segredo do agendador de lembretes. A Vercel envia "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Só para rodar `npm start` em rede local via http (sem HTTPS):
# COOKIE_SECURE=false
